{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/requests/plugin_failure.json",
  "title": "Plugin failure request",
  "description": "Plugin failure content. Core stamps the record type, time and Plugin identity.",
  "type": "object",
  "required": [
    "request_id",
    "explanation"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "$ref": "../variables/request_id.json"
    },
    "explanation": {
      "$ref": "../variables/explanation.json"
    },
    "geofeature_ids": {
      "type": "array",
      "items": {
        "$ref": "../variables/geofeature_id.json"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "object_ids": {
      "type": "array",
      "items": {
        "$ref": "../variables/object_id.json"
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "examples": [
    {
      "request_id": 123,
      "explanation": "Imagery service stopped answering",
      "object_ids": [
        "F3"
      ]
    }
  ]
}
