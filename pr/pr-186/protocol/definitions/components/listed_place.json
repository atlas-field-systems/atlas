{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/listed_place.json",
  "title": "Listed place",
  "description": "A point, line or area suggested in a Plugin answer.",
  "type": "object",
  "required": [
    "kind"
  ],
  "oneOf": [
    {
      "$ref": "../records/geofeature/point.json"
    },
    {
      "$ref": "../records/geofeature/line.json"
    },
    {
      "$ref": "../records/geofeature/area.json"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "kind": {
      "$ref": "../variables/kind.json"
    },
    "name": {
      "$ref": "../variables/name.json"
    }
  },
  "examples": [
    {
      "kind": "area",
      "name": "North field",
      "area": [
        {
          "latitude": 42.2761,
          "longitude": -71.8031
        },
        {
          "latitude": 42.2768,
          "longitude": -71.8012
        },
        {
          "latitude": 42.2752,
          "longitude": -71.8004
        },
        {
          "latitude": 42.2747,
          "longitude": -71.8025
        }
      ]
    },
    {
      "kind": "point",
      "position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      }
    }
  ]
}
