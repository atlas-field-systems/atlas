{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/queue.json",
  "title": "Queue",
  "description": "An Asset's whole task list, in the order it runs: every Task it has not started, each a whole Task body. It replaces the Asset's list. queue_version is the version of the Asset's list it was built on. A Task that leaves the list without starting is reported cancelled. An empty list clears the queue.",
  "type": "object",
  "required": [
    "time",
    "asset_id",
    "queue_version",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "queue_version": {
      "$ref": "../variables/queue_version.json"
    },
    "now": {
      "$ref": "../variables/now.json"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "task.json"
      },
      "maxItems": 64
    }
  },
  "examples": [
    {
      "time": 1793667605260,
      "asset_id": "A1",
      "queue_version": 0,
      "tasks": [
        {
          "time": 1793667605000,
          "asset_id": "A1",
          "task_id": "T1",
          "requested_by": "OP1",
          "kind": "takeoff",
          "target_altitude": {
            "altitude_m": 30,
            "altitude_reference": "launch"
          }
        },
        {
          "time": 1793667605100,
          "asset_id": "A1",
          "task_id": "T2",
          "requested_by": "OP1",
          "kind": "move_to",
          "destination": {
            "latitude": 42.2746,
            "longitude": -71.8063
          }
        }
      ]
    },
    {
      "time": 1793667700000,
      "asset_id": "A1",
      "queue_version": 2,
      "now": true,
      "tasks": [
        {
          "time": 1793667699900,
          "asset_id": "A1",
          "task_id": "T6",
          "requested_by": "OP2",
          "kind": "return_to_home"
        }
      ]
    }
  ]
}
