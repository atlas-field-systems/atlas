{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/settings.json",
  "title": "settings",
  "description": "An Asset's settings, each an explicit end state. At least one is present. home_position is where return_to_home goes. The Asset sets it to where it starts up, and an operator can move it.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "run_state": {
      "$ref": "../variables/run_state.json"
    },
    "lights": {
      "$ref": "../variables/lights.json"
    },
    "landing_gear": {
      "$ref": "../variables/landing_gear.json"
    },
    "link_loss_response": {
      "$ref": "../variables/link_loss_response.json"
    },
    "link_loss_after_s": {
      "$ref": "../variables/link_loss_after_s.json"
    },
    "low_battery_response": {
      "$ref": "../variables/low_battery_response.json"
    },
    "home_position": {
      "$ref": "position.json"
    },
    "telemetry_every_s": {
      "$ref": "../variables/telemetry_every_s.json"
    }
  },
  "examples": [
    {
      "run_state": "running",
      "lights": "off",
      "landing_gear": "down",
      "link_loss_response": "return_to_home",
      "link_loss_after_s": 30,
      "low_battery_response": "land",
      "home_position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      },
      "telemetry_every_s": 1
    },
    {
      "lights": "on"
    }
  ]
}
