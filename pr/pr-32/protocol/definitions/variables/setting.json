{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/variables/setting.json",
  "title": "setting",
  "description": "One setting an Asset supports: the name of a field in the settings component. Supporting a setting is separate from knowing its current value.",
  "enum": [
    "run_state",
    "lights",
    "landing_gear",
    "link_loss_response",
    "link_loss_after_s",
    "low_battery_response",
    "home_position",
    "telemetry_every_s"
  ],
  "examples": [
    "run_state"
  ]
}
