{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/report/status/subsystem.json",
  "title": "subsystem",
  "description": "One subsystem's condition, from the Asset's declared subsystems. Each report updates one subsystem; several travel as several reports in one batch, and a subsystem left out is unchanged. When a fault or degradation clears, the Asset reports the new condition. explanation says what is limited or faulted.",
  "type": "object",
  "required": [
    "kind",
    "subsystem_id",
    "condition"
  ],
  "properties": {
    "kind": {
      "$ref": "../../../variables/kind.json",
      "const": "subsystem"
    },
    "subsystem_id": {
      "$ref": "../../../variables/subsystem_id.json"
    },
    "condition": {
      "$ref": "../../../variables/condition.json"
    },
    "explanation": {
      "$ref": "../../../variables/explanation.json"
    }
  },
  "examples": [
    {
      "kind": "subsystem",
      "subsystem_id": "GPS",
      "condition": "degraded",
      "explanation": "4 satellites, position error over 10 m"
    }
  ]
}
