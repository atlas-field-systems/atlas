{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/task/land.json",
  "title": "land",
  "description": "Land at a position. Without a landing position, the Asset lands where it is when the Task starts. The Asset climbs or descends to the transit altitude, or keeps its current altitude if none is given. It flies over the position and lands.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "$ref": "../../variables/kind.json",
      "const": "land"
    },
    "landing_position": {
      "$ref": "../../components/position.json"
    },
    "transit_altitude": {
      "$ref": "../../components/altitude.json"
    }
  },
  "examples": [
    {
      "kind": "land",
      "landing_position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      },
      "transit_altitude": {
        "altitude_m": 20,
        "altitude_reference": "launch"
      }
    },
    {
      "kind": "land"
    }
  ]
}
