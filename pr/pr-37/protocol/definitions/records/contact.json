{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/contact.json",
  "title": "Contact",
  "description": "Whether an Asset, gateway, or Plugin is in contact. time is when it was last heard from, so an offline record keeps the last time it was heard. It names exactly one of asset_id, gateway_id, or plugin_id. Core records its own view in asset.contact, gateway.contact, and plugin.contact events. A gateway sends this record for each Asset it carries whenever its Fieldlink's view of that Asset changes, and Core takes that as its view.",
  "type": "object",
  "required": [
    "time",
    "contact"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "gateway_id": {
      "$ref": "../variables/gateway_id.json"
    },
    "plugin_id": {
      "$ref": "../variables/plugin_id.json"
    },
    "contact": {
      "$ref": "../variables/contact.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "asset_id": "A1",
      "contact": "online"
    },
    {
      "time": 1793667600000,
      "asset_id": "R7",
      "contact": "offline"
    },
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "contact": "online"
    },
    {
      "time": 1793667600000,
      "plugin_id": "P1",
      "contact": "online"
    }
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "asset_id"
          ]
        },
        {
          "required": [
            "gateway_id"
          ]
        },
        {
          "required": [
            "plugin_id"
          ]
        }
      ]
    }
  ]
}
