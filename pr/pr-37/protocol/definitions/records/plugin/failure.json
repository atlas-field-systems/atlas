{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/plugin/failure.json",
  "title": "Plugin failure",
  "description": "A Plugin's answer that a call did not finish, named by request_id: an explanation for operators, and the IDs of any geo features and Objects it had already created for this call, which stay. Core adds it as plugin.failed.",
  "type": "object",
  "required": [
    "type",
    "time",
    "plugin_id",
    "request_id",
    "explanation"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "plugin.failure"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "plugin_id": {
      "$ref": "../../variables/plugin_id.json"
    },
    "request_id": {
      "$ref": "../../variables/request_id.json"
    },
    "explanation": {
      "$ref": "../../variables/explanation.json"
    },
    "geofeature_ids": {
      "type": "array",
      "items": {
        "$ref": "../../variables/geofeature_id.json"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "object_ids": {
      "type": "array",
      "items": {
        "$ref": "../../variables/object_id.json"
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "examples": [
    {
      "type": "plugin.failure",
      "time": 1793667707000,
      "plugin_id": "P1",
      "request_id": 122,
      "explanation": "Area too large: more than 1000 buildings. Pick a smaller area."
    },
    {
      "type": "plugin.failure",
      "time": 1793667708000,
      "plugin_id": "P2",
      "request_id": 123,
      "explanation": "Imagery service stopped answering",
      "object_ids": [
        "F3"
      ]
    }
  ]
}
