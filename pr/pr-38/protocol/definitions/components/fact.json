{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/fact.json",
  "title": "Fact",
  "description": "One short fact in a Plugin result: a label and its value as text a person reads, such as \"Wind\" and \"12 m/s from the west\".",
  "type": "object",
  "required": [
    "label",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "label": {
      "$ref": "../variables/label.json"
    },
    "text": {
      "$ref": "../variables/text.json"
    }
  },
  "examples": [
    {
      "label": "Wind",
      "text": "12 m/s from the west"
    }
  ]
}
