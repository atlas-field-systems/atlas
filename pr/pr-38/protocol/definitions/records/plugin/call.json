{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/plugin/call.json",
  "title": "Plugin call",
  "description": "One accepted call of a Plugin action: the action and its input values, at most 16, and the account that asked. Core stamps time, plugin_id, action, and requested_by onto the requests.plugin_call body and adds it as plugin.called. The event's event_id names the call; answers name it as request_id.",
  "type": "object",
  "required": [
    "type",
    "time",
    "plugin_id",
    "action",
    "inputs",
    "requested_by"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "plugin.call"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "plugin_id": {
      "$ref": "../../variables/plugin_id.json"
    },
    "action": {
      "$ref": "../../variables/action.json"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "../../components/input_value.json"
      },
      "maxItems": 16
    },
    "requested_by": {
      "$ref": "../../variables/requested_by.json"
    }
  },
  "examples": [
    {
      "type": "plugin.call",
      "time": 1793667701000,
      "plugin_id": "P1",
      "action": "find_buildings",
      "inputs": [
        {
          "input": "box",
          "kind": "area",
          "area": [
            {
              "latitude": 42.2761,
              "longitude": -71.8031
            },
            {
              "latitude": 42.2768,
              "longitude": -71.8012
            },
            {
              "latitude": 42.2752,
              "longitude": -71.8004
            },
            {
              "latitude": 42.2747,
              "longitude": -71.8025
            }
          ]
        }
      ],
      "requested_by": "OP1"
    },
    {
      "type": "plugin.call",
      "time": 1793667702000,
      "plugin_id": "P1",
      "action": "places",
      "inputs": [
        {
          "input": "box",
          "kind": "area",
          "area": [
            {
              "latitude": 42.2761,
              "longitude": -71.8031
            },
            {
              "latitude": 42.2768,
              "longitude": -71.8012
            },
            {
              "latitude": 42.2752,
              "longitude": -71.8004
            },
            {
              "latitude": 42.2747,
              "longitude": -71.8025
            }
          ]
        },
        {
          "input": "type",
          "kind": "choice",
          "choice": "hospital"
        }
      ],
      "requested_by": "OP1"
    }
  ]
}
