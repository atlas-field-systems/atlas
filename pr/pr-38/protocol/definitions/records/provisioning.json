{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/provisioning.json",
  "title": "Provisioning",
  "description": "An Asset, gateway, or Plugin was added to Core or removed from it. It names exactly one of asset_id, gateway_id, or plugin_id. The event kind says whether it was provisioned or removed, so the record does not. requested_by is the admin who did it, or the gateway that added a radio Asset on first contact. A radio Asset's record also names its radio_identity. What kind of Asset it is comes later, from its description.",
  "type": "object",
  "required": [
    "time",
    "requested_by"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "gateway_id": {
      "$ref": "../variables/gateway_id.json"
    },
    "plugin_id": {
      "$ref": "../variables/plugin_id.json"
    },
    "radio_identity": {
      "$ref": "../variables/radio_identity.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "asset_id": "A1",
      "requested_by": "AD1"
    },
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "requested_by": "AD1"
    },
    {
      "time": 1793667605000,
      "asset_id": "R7",
      "requested_by": "G1",
      "radio_identity": "meshtastic:q3Vb0n8fW2aJ6kXyR1tLmE4sP9dZcHgU7oNiTvB5wQA="
    },
    {
      "time": 1793667600000,
      "plugin_id": "P1",
      "requested_by": "AD1"
    }
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "asset_id"
          ]
        },
        {
          "required": [
            "gateway_id"
          ]
        },
        {
          "required": [
            "plugin_id"
          ]
        }
      ]
    },
    {
      "if": {
        "required": [
          "radio_identity"
        ]
      },
      "then": {
        "required": [
          "asset_id"
        ]
      }
    }
  ]
}
