{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/provisioning.json",
  "title": "Provisioning",
  "description": "An Asset registered in the run or was removed from it, or a gateway or Plugin was provisioned or removed. It names exactly one of asset_id, gateway_id, or plugin_id. The event kind says which, so the record does not. requested_by is the admin who provisioned or removed it, or the gateway that registered a radio Asset. An Asset on IP that registered itself has no requested_by: the Asset itself asked. What kind of Asset it is comes from its description.",
  "type": "object",
  "required": [
    "time"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "gateway_id": {
      "$ref": "../variables/gateway_id.json"
    },
    "plugin_id": {
      "$ref": "../variables/plugin_id.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "asset_id": "A1"
    },
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "requested_by": "AD1"
    },
    {
      "time": 1793667605000,
      "asset_id": "R7",
      "requested_by": "G1"
    },
    {
      "time": 1793667600000,
      "plugin_id": "P1",
      "requested_by": "AD1"
    }
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "asset_id"
          ]
        },
        {
          "required": [
            "gateway_id"
          ]
        },
        {
          "required": [
            "plugin_id"
          ]
        }
      ]
    },
    {
      "if": {
        "not": {
          "required": [
            "asset_id"
          ]
        }
      },
      "then": {
        "required": [
          "requested_by"
        ]
      }
    }
  ]
}
