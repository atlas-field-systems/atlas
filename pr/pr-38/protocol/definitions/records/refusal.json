{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/refusal.json",
  "title": "Refusal",
  "description": "Core refused a caller with a different definitions hash, and added it as definitions.refused: an Asset on IP, a gateway, or a Plugin, named by its ID, and the definitions_hash it sent. A radio's hash is checked by its gateway's Fieldlink, not by Core.",
  "type": "object",
  "required": [
    "time",
    "definitions_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "gateway_id": {
      "$ref": "../variables/gateway_id.json"
    },
    "plugin_id": {
      "$ref": "../variables/plugin_id.json"
    },
    "definitions_hash": {
      "$ref": "../variables/definitions_hash.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "plugin_id": "P1",
      "definitions_hash": "sha256:41aa07"
    },
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "definitions_hash": "sha256:41aa07"
    },
    {
      "time": 1793667600000,
      "asset_id": "A1",
      "definitions_hash": "sha256:41aa07"
    }
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "asset_id"
          ]
        },
        {
          "required": [
            "gateway_id"
          ]
        },
        {
          "required": [
            "plugin_id"
          ]
        }
      ]
    }
  ]
}
