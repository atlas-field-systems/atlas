{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/input_value/position.json",
  "title": "position",
  "description": "A position on the map. Only latitude and longitude are used unless the action's label says otherwise.",
  "type": "object",
  "required": [
    "kind",
    "position"
  ],
  "properties": {
    "kind": {
      "$ref": "../../variables/kind.json",
      "const": "position"
    },
    "position": {
      "$ref": "../../components/position.json"
    }
  },
  "examples": [
    {
      "kind": "position",
      "position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      }
    }
  ]
}
