{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/settings_change.json",
  "title": "Settings change",
  "description": "Change an Asset's settings now, each to an explicit end state, independently of its queue. The Asset confirms it with a report.settings whose request_id names it. To change settings when a Task runs, use a Task of kind settings.",
  "type": "object",
  "required": [
    "time",
    "asset_id",
    "requested_by",
    "settings"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    },
    "settings": {
      "$ref": "../components/settings.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "asset_id": "A1",
      "requested_by": "OP1",
      "settings": {
        "lights": "on"
      }
    },
    {
      "time": 1793667600000,
      "asset_id": "A1",
      "requested_by": "OP1",
      "settings": {
        "failsafe_policy": [
          {
            "rule_id": "LB1",
            "priority": 90,
            "conditions": [
              {
                "kind": "battery_below",
                "battery_percent": 15
              }
            ],
            "response": {
              "kind": "land"
            }
          }
        ],
        "home_position": {
          "latitude": 42.2751,
          "longitude": -71.8049
        }
      }
    }
  ]
}
