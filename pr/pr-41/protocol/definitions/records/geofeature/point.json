{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/geofeature/point.json",
  "title": "point",
  "description": "A geo feature that is one place, such as a helipad.",
  "type": "object",
  "required": [
    "kind",
    "position"
  ],
  "properties": {
    "kind": {
      "$ref": "../../variables/kind.json",
      "const": "point"
    },
    "position": {
      "$ref": "../../components/position.json"
    }
  },
  "examples": [
    {
      "kind": "point",
      "position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      }
    }
  ]
}
