{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/deletion.json",
  "title": "Deletion",
  "description": "An operator deleted an Object. Core adds it as object.deleted. The Object and its file are hidden for the rest of the run, not destroyed: Core keeps both, marked deleted, for the run's Reset ZIP. The Object's earlier events stay in history.",
  "type": "object",
  "required": [
    "time",
    "object_id",
    "requested_by"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "object_id": {
      "$ref": "../variables/object_id.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    }
  },
  "examples": [
    {
      "time": 1793667900000,
      "object_id": "F1",
      "requested_by": "OP1"
    }
  ]
}
