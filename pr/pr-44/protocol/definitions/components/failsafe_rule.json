{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/failsafe_rule.json",
  "title": "failsafe_rule",
  "description": "One failsafe rule: its rule_id, its priority, the conditions that must all hold, its response, and an optional fallback that runs once if the response fails. A rule with a critical battery condition falls back to Land whatever fallback it names. Alternative combinations of conditions are separate rules.",
  "type": "object",
  "required": [
    "rule_id",
    "priority",
    "conditions",
    "response"
  ],
  "additionalProperties": false,
  "properties": {
    "rule_id": {
      "$ref": "../variables/rule_id.json"
    },
    "priority": {
      "$ref": "../variables/priority.json"
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "failsafe_condition.json"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "response": {
      "$ref": "failsafe_response.json"
    },
    "fallback": {
      "$ref": "failsafe_response.json"
    }
  },
  "examples": [
    {
      "rule_id": "LB2",
      "priority": 80,
      "conditions": [
        {
          "kind": "battery_below",
          "battery_percent": 25
        },
        {
          "kind": "airborne"
        }
      ],
      "response": {
        "kind": "return_to_home"
      },
      "fallback": {
        "kind": "land"
      }
    }
  ]
}
