{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/description.json",
  "title": "Description",
  "description": "The Asset declares its optional entity_type, the reports it sends, the command kinds it accepts, the settings it supports, its subsystems, and its cameras. The command list is empty for a receive-only Asset, and an Asset with no settings leaves the settings list out. Supporting a setting is separate from knowing its value. Its subsystems stay the same for the operation; an Asset that reports no subsystem conditions leaves the list out. An Asset on IP registers with these fields, without time and asset_id, as requests.asset; Core assigns asset_id and stamps time to make this record. A gateway sends the record itself, with the asset_id, to sign up a radio Asset. An Asset signs up each time its app starts, never on a reconnect. Core never sends a Task whose kind the Asset does not list, or a settings change that names a setting it does not list.",
  "type": "object",
  "required": [
    "time",
    "asset_id",
    "reports",
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "entity_type": {
      "$ref": "../variables/entity_type.json"
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "../variables/report.json"
      },
      "minItems": 1,
      "maxItems": 6
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "../variables/command.json"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "../variables/setting.json"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "subsystems": {
      "type": "array",
      "items": {
        "$ref": "../components/subsystem.json"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "../components/camera.json"
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "examples": [
    {
      "time": 1793667600100,
      "asset_id": "A1",
      "entity_type": "drone",
      "reports": [
        "status",
        "failsafe",
        "telemetry",
        "battery",
        "settings"
      ],
      "commands": [
        "takeoff",
        "move_to",
        "land",
        "return_to_home",
        "hold",
        "failsafe"
      ],
      "settings": [
        "run_state",
        "lights",
        "landing_gear",
        "link_loss_after_s",
        "failsafe_policy",
        "home_position",
        "telemetry_every_s"
      ],
      "subsystems": [
        {
          "subsystem_id": "FC",
          "label": "Flight controller"
        },
        {
          "subsystem_id": "GPS",
          "label": "GPS receiver"
        },
        {
          "subsystem_id": "C1",
          "label": "Gimbal camera"
        }
      ],
      "cameras": [
        {
          "camera_id": "C1",
          "mount": "gimbal",
          "yaw_deg": 0,
          "pitch_deg": -45,
          "horizontal_fov_deg": 80,
          "vertical_fov_deg": 60
        }
      ]
    },
    {
      "time": 1793667600100,
      "asset_id": "B1",
      "entity_type": "fixed_sensor",
      "reports": [
        "status",
        "observation"
      ],
      "commands": []
    }
  ]
}
