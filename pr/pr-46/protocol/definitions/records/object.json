{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/object.json",
  "title": "Object",
  "description": "A file Core holds: its name, media type, and size, the geo feature it is attached to if any, and the account, Plugin, or Asset that stored it. time is when Core stored this version: an attach, move, or detach changes only geofeature_id and time. The file itself never travels in a record; callers fetch it by object_id. Core adds it as object.stored and object.changed.",
  "type": "object",
  "required": [
    "time",
    "object_id",
    "name",
    "content_type",
    "size_bytes",
    "requested_by"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "object_id": {
      "$ref": "../variables/object_id.json"
    },
    "name": {
      "$ref": "../variables/name.json"
    },
    "content_type": {
      "$ref": "../variables/content_type.json"
    },
    "size_bytes": {
      "$ref": "../variables/size_bytes.json"
    },
    "geofeature_id": {
      "$ref": "../variables/geofeature_id.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    }
  },
  "examples": [
    {
      "time": 1793667830000,
      "object_id": "F1",
      "name": "roof-survey.jpg",
      "content_type": "image/jpeg",
      "size_bytes": 2483117,
      "geofeature_id": "G1",
      "requested_by": "OP1"
    },
    {
      "time": 1793667840000,
      "object_id": "F2",
      "name": "north-field.tif",
      "content_type": "image/tiff",
      "size_bytes": 48211904,
      "requested_by": "P2"
    },
    {
      "time": 1793667850000,
      "object_id": "F3",
      "name": "pad-check.jpg",
      "content_type": "image/jpeg",
      "size_bytes": 3104822,
      "geofeature_id": "G4",
      "requested_by": "A1"
    }
  ]
}
