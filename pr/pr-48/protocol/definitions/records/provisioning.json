{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/provisioning.json",
  "title": "Provisioning",
  "description": "An admin provisioned or removed a gateway or Plugin. It names exactly one of gateway_id or plugin_id, and requested_by is the admin. The event kind says which, so the record does not. Assets are not provisioned; they join a run by registration.",
  "type": "object",
  "required": [
    "time",
    "requested_by"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "gateway_id": {
      "$ref": "../variables/gateway_id.json"
    },
    "plugin_id": {
      "$ref": "../variables/plugin_id.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "requested_by": "AD1"
    },
    {
      "time": 1793667600000,
      "plugin_id": "P1",
      "requested_by": "AD1"
    }
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "gateway_id"
          ]
        },
        {
          "required": [
            "plugin_id"
          ]
        }
      ]
    }
  ]
}
