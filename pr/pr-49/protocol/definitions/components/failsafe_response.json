{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/failsafe_response.json",
  "title": "failsafe_response",
  "description": "What a failsafe rule does: one command kind the Asset lists in its description, with its fields, as in a Task. It never names a settings change. Its parameters are fixed when it starts: a land without a landing position lands where the Asset is at activation, and return_to_home uses the home_position setting at activation. It never names a geo feature: a failsafe runs from what the Asset holds, so its response gives positions directly.",
  "type": "object",
  "required": [
    "kind"
  ],
  "oneOf": [
    {
      "$ref": "../records/task/takeoff.json"
    },
    {
      "$ref": "../records/task/move_to.json"
    },
    {
      "$ref": "../records/task/land.json"
    },
    {
      "$ref": "../records/task/return_to_home.json"
    },
    {
      "$ref": "../records/task/hold.json"
    },
    {
      "$ref": "../records/task/point_at.json"
    },
    {
      "$ref": "../records/task/capture.json"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "kind": {
      "$ref": "../variables/kind.json"
    }
  },
  "examples": [
    {
      "kind": "return_to_home"
    },
    {
      "kind": "land"
    },
    {
      "kind": "hold"
    },
    {
      "kind": "capture",
      "camera_id": "C1",
      "media": "photo"
    },
    {
      "kind": "capture",
      "camera_id": "C1",
      "media": "clip",
      "duration_s": 10
    }
  ],
  "not": {
    "required": [
      "geofeature_id"
    ]
  }
}
