{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/drop.json",
  "title": "Drop",
  "description": "Core stopped waiting for an answer that never came. The event kind says which: task.dropped names a Task the Asset never confirmed it holds, or one with no final report when the Asset's app started again and so no longer holds it (asset_id and task_id); request.dropped names a request the Asset did not answer before it went offline (asset_id and request_id); plugin.dropped names a call the Plugin did not answer before it went offline or was removed (plugin_id and request_id). A drop does not prove the request never arrived, and claims no outcome for a Task. The Asset's stream carries task.dropped, and the Asset never runs a dropped Task.",
  "type": "object",
  "required": [
    "time"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "asset_id",
        "task_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "request_id"
            ]
          },
          {
            "required": [
              "plugin_id"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "asset_id",
        "request_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "task_id"
            ]
          },
          {
            "required": [
              "plugin_id"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "plugin_id",
        "request_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "task_id"
            ]
          },
          {
            "required": [
              "asset_id"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "task_id": {
      "$ref": "../variables/task_id.json"
    },
    "plugin_id": {
      "$ref": "../variables/plugin_id.json"
    },
    "request_id": {
      "$ref": "../variables/request_id.json"
    }
  },
  "examples": [
    {
      "time": 1793667950000,
      "asset_id": "A1",
      "task_id": 7
    },
    {
      "time": 1793667950000,
      "asset_id": "A1",
      "request_id": 131
    },
    {
      "time": 1793667960000,
      "plugin_id": "P1",
      "request_id": 118
    }
  ]
}
