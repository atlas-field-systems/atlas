{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/requests/attach.json",
  "title": "Attach request",
  "description": "The body of PATCH /objects/{object_id}; null detaches the Object.",
  "type": "object",
  "required": [
    "geofeature_id"
  ],
  "additionalProperties": false,
  "properties": {
    "geofeature_id": {
      "$ref": "../variables/attachment.json"
    }
  },
  "examples": [
    {
      "geofeature_id": "P1"
    },
    {
      "geofeature_id": null
    }
  ]
}
