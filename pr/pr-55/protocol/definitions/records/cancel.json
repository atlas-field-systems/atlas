{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/cancel.json",
  "title": "Cancel",
  "description": "Cancel one Task, and only that Task, whether it is queued or running. The Asset reports it cancelled with report.status kind task, whose request_id names this cancel.",
  "type": "object",
  "required": [
    "time",
    "asset_id",
    "task_id",
    "requested_by"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "task_id": {
      "$ref": "../variables/task_id.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "asset_id": "A1",
      "task_id": 2,
      "requested_by": "OP1"
    }
  ]
}
