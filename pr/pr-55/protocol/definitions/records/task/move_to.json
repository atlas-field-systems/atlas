{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/task/move_to.json",
  "title": "move_to",
  "description": "Fly to a position: destination, or a point geo feature named by geofeature_id. A request gives one of them. When Core accepts a Task that names a geo feature, it copies the place's position into destination and keeps geofeature_id to say which place it came from, so the Task keeps the place as it was when sent. A later edit reaches the Task only if the operator chooses to update it. If the position has no altitude, the Asset keeps its current altitude.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "$ref": "../../variables/kind.json",
      "const": "move_to"
    },
    "destination": {
      "$ref": "../../components/position.json"
    },
    "geofeature_id": {
      "$ref": "../../variables/geofeature_id.json"
    },
    "ground_speed_mps": {
      "$ref": "../../variables/ground_speed_mps.json"
    }
  },
  "examples": [
    {
      "kind": "move_to",
      "destination": {
        "latitude": 42.2746,
        "longitude": -71.8063,
        "altitudes": [
          {
            "altitude_m": 30,
            "altitude_reference": "launch"
          }
        ]
      }
    },
    {
      "kind": "move_to",
      "geofeature_id": "G2"
    },
    {
      "kind": "move_to",
      "geofeature_id": "G2",
      "destination": {
        "latitude": 42.2751,
        "longitude": -71.8049
      }
    },
    {
      "kind": "move_to",
      "destination": {
        "latitude": 42.2746,
        "longitude": -71.8063,
        "altitudes": [
          {
            "altitude_m": 30,
            "altitude_reference": "launch"
          }
        ]
      },
      "ground_speed_mps": 4.2
    }
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "destination"
          ]
        },
        {
          "required": [
            "geofeature_id"
          ]
        }
      ]
    }
  ]
}
