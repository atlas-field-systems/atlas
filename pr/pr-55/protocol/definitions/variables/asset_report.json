{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/variables/asset_report.json",
  "title": "asset_report",
  "description": "One complete Asset report in a report batch.",
  "oneOf": [
    {
      "$ref": "../records/report/status.json"
    },
    {
      "$ref": "../records/report/failsafe.json"
    },
    {
      "$ref": "../records/report/telemetry.json"
    },
    {
      "$ref": "../records/report/battery.json"
    },
    {
      "$ref": "../records/report/gimbal.json"
    },
    {
      "$ref": "../records/report/settings.json"
    },
    {
      "$ref": "../records/report/observation.json"
    }
  ],
  "examples": [
    {
      "type": "report.status",
      "time": 1793667600000,
      "asset_id": "A1",
      "kind": "subsystem",
      "subsystem_id": "GPS",
      "condition": "degraded",
      "explanation": "4 satellites, position error over 10 m"
    },
    {
      "type": "report.failsafe",
      "time": 1793667600000,
      "asset_id": "A1",
      "kind": "response",
      "rule_id": "LB2",
      "task_state": "active",
      "response": {
        "kind": "return_to_home"
      },
      "explanation": "Battery at 24 % while airborne"
    },
    {
      "type": "report.telemetry",
      "time": 1793667600000,
      "asset_id": "A1",
      "position": {
        "latitude": 42.2746,
        "longitude": -71.8063,
        "altitudes": [
          {
            "altitude_m": 30,
            "altitude_reference": "launch"
          },
          {
            "altitude_m": 215.4,
            "altitude_reference": "msl"
          }
        ]
      },
      "ground_speed_mps": 4.2,
      "heading_deg": 90
    },
    {
      "type": "report.battery",
      "time": 1793667600000,
      "asset_id": "A1",
      "battery_percent": 82
    },
    {
      "type": "report.gimbal",
      "time": 1793667600000,
      "asset_id": "A1",
      "camera_id": "C1",
      "yaw_deg": 35,
      "pitch_deg": -30
    },
    {
      "type": "report.settings",
      "time": 1793667600000,
      "asset_id": "A1",
      "settings": {
        "lights": "on",
        "landing_gear": "down",
        "telemetry_every_s": 1
      }
    },
    {
      "type": "report.observation",
      "time": 1793667600000,
      "asset_id": "A3",
      "kind": "coordinates",
      "observation_id": "O1",
      "entity_type": "airplane",
      "position": {
        "latitude": 42.2758,
        "longitude": -71.8041,
        "altitudes": [
          {
            "altitude_m": 1250,
            "altitude_reference": "msl"
          }
        ]
      },
      "uncertainty": {
        "semi_major_m": 30,
        "altitude_uncertainty_m": 15
      },
      "details": {
        "icao_address": "A1B2C3",
        "callsign": "N123AB",
        "squawk": "1200"
      }
    }
  ]
}
