{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/plugin/describe.json",
  "title": "Plugin describe",
  "description": "From Core (from is CORE) to an operator interface: one Plugin and the actions it offers. Core sends one per Plugin after an accepted operator hello, and in answer to query.core kind plugins. Core refuses a plugin.call for an action the Plugin does not list.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "from",
    "plugin_id",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "plugin.describe"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "from": {
      "$ref": "../../variables/from.json"
    },
    "plugin_id": {
      "$ref": "../../variables/plugin_id.json"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "../../variables/action.json"
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "examples": [
    {
      "type": "plugin.describe",
      "time": 1793667700100,
      "seq": 101,
      "from": "CORE",
      "plugin_id": "DEM",
      "actions": [
        "ground_elevation"
      ]
    }
  ]
}
