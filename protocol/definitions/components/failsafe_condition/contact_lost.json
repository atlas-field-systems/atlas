{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/failsafe_condition/contact_lost.json",
  "title": "contact_lost",
  "description": "The time since the Asset last heard from its link has reached for_s seconds on its own clock.",
  "type": "object",
  "required": [
    "kind",
    "for_s"
  ],
  "properties": {
    "for_s": {
      "$ref": "../../variables/for_s.json"
    },
    "kind": {
      "$ref": "../../variables/kind.json",
      "const": "contact_lost"
    }
  },
  "examples": [
    {
      "kind": "contact_lost",
      "for_s": 30
    }
  ]
}
