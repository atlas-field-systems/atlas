{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/failsafe_condition/measurement_stale.json",
  "title": "measurement_stale",
  "description": "A measurement is missing or stale: none was taken within stale_after_s. This is distinct from any current value.",
  "type": "object",
  "required": [
    "kind",
    "measurement",
    "stale_after_s"
  ],
  "properties": {
    "kind": {
      "$ref": "../../variables/kind.json",
      "const": "measurement_stale"
    },
    "measurement": {
      "$ref": "../../variables/measurement.json"
    },
    "stale_after_s": {
      "$ref": "../../variables/stale_after_s.json"
    }
  },
  "examples": [
    {
      "kind": "measurement_stale",
      "measurement": "position",
      "stale_after_s": 5
    }
  ]
}
