{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/input_value/text.json",
  "title": "text",
  "description": "Short text, such as a street name.",
  "type": "object",
  "required": [
    "kind",
    "text"
  ],
  "properties": {
    "kind": {
      "$ref": "../../variables/kind.json",
      "const": "text"
    },
    "text": {
      "$ref": "../../variables/text.json"
    }
  },
  "examples": [
    {
      "kind": "text",
      "text": "Main Street"
    }
  ]
}
