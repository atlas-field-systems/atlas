{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/components/plugin_action.json",
  "title": "Plugin action",
  "description": "One action a Plugin offers: its name, a label for operators, and the inputs it takes, at most 16. Its answer is a plugin.result or plugin.failure, the same for every action.",
  "type": "object",
  "required": [
    "action",
    "label",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "../variables/action.json"
    },
    "label": {
      "$ref": "../variables/label.json"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "plugin_input.json"
      },
      "maxItems": 16
    }
  },
  "examples": [
    {
      "action": "find_buildings",
      "label": "Find buildings",
      "inputs": [
        {
          "input": "box",
          "label": "Area to search",
          "input_kind": "area"
        }
      ]
    }
  ]
}
