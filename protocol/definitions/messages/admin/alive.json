{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/admin/alive.json",
  "title": "Alive",
  "description": "From Core to an Asset when Core has sent it nothing for a third of its link_loss_after_s, so the Asset can tell a quiet Core from a lost link. It carries nothing else: any new message from Core counts as contact.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "admin.alive"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    }
  },
  "examples": [
    {
      "type": "admin.alive",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1"
    }
  ]
}
