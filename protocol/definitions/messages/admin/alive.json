{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/admin/alive.json",
  "title": "Alive",
  "description": "Sent by Core to an Asset, or by an Asset to Core, when the sender has sent the other nothing new for a third of the Asset's link_loss_after_s (repeated answers to retries don't count), so a quiet end is not mistaken for a lost link. From Core, it is contact for the Asset's link_loss failsafe. From the Asset (from is its id), it keeps Core counting the Asset connected.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "from",
    "asset_id"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "admin.alive"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "from": {
      "$ref": "../../variables/from.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    }
  },
  "examples": [
    {
      "type": "admin.alive",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "from": "CORE"
    },
    {
      "type": "admin.alive",
      "time": 1793667600500,
      "seq": 12,
      "asset_id": "A1",
      "from": "A1"
    }
  ]
}
