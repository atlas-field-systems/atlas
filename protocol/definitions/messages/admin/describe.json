{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/admin/describe.json",
  "title": "Describe",
  "description": "An Asset's description after an accepted hello: what it is (entity_type, optional), which reports it sends, which command kinds it accepts (empty for a receive-only Asset), and its cameras. No keys. Core stores it, acknowledges it with admin.reply (the Asset resends it until then and sends nothing else first), and forwards it unchanged to operator interfaces (same from, seq and time). Core never sends a command kind the Asset does not list. Supported settings are not listed here: the Asset's connect report.settings carries only the settings it has.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "from",
    "asset_id",
    "reports",
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "admin.describe"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "from": {
      "$ref": "../../variables/from.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    },
    "entity_type": {
      "$ref": "../../variables/entity_type.json"
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "../../variables/report.json"
      },
      "minItems": 1,
      "maxItems": 7
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "../../variables/command.json"
      },
      "minItems": 0,
      "maxItems": 4
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "../../components/camera.json"
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "examples": [
    {
      "type": "admin.describe",
      "time": 1793667600100,
      "seq": 43,
      "from": "A1",
      "asset_id": "A1",
      "entity_type": "drone",
      "reports": [
        "status",
        "failsafe",
        "telemetry",
        "battery",
        "settings",
        "gimbal",
        "observation"
      ],
      "commands": [
        "takeoff",
        "move_to",
        "land",
        "return_to_home"
      ],
      "cameras": [
        {
          "camera_id": "C1",
          "mount": "gimbal",
          "yaw_deg": 0,
          "pitch_deg": -45,
          "horizontal_fov_deg": 80,
          "vertical_fov_deg": 60
        }
      ]
    },
    {
      "type": "admin.describe",
      "time": 1793667600100,
      "seq": 2,
      "from": "R1",
      "asset_id": "R1",
      "reports": [
        "status",
        "observation"
      ],
      "commands": []
    }
  ]
}
