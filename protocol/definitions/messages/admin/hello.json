{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/admin/hello.json",
  "title": "Hello",
  "description": "First message from an Asset when a link opens: which Asset it is, which protocol version it runs, which reports it sends and which command kinds it accepts. Core never sends a command kind the Asset does not list. Supported settings are not listed here: the Asset's report.settings on connect carries only the settings it has, and Core never sends others. Authentication (an API key) is handled by the link, not this message.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id",
    "protocol_version",
    "reports",
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "admin.hello"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    },
    "protocol_version": {
      "$ref": "../../variables/protocol_version.json"
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "../../variables/report.json"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "../../variables/command.json"
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "examples": [
    {
      "type": "admin.hello",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "protocol_version": "0.3",
      "reports": [
        "status",
        "failsafe",
        "telemetry",
        "battery",
        "settings"
      ],
      "commands": [
        "takeoff",
        "move_to",
        "land"
      ]
    }
  ]
}
