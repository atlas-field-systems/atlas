{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/control/command.json",
  "title": "Command",
  "description": "From Core: do this now. Never queued; the Asset acts on it as soon as it arrives. kind says which command.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id",
    "kind"
  ],
  "oneOf": [
    {
      "$ref": "command/takeoff.json"
    },
    {
      "$ref": "command/move_to.json"
    },
    {
      "$ref": "command/land.json"
    },
    {
      "$ref": "command/change_settings.json"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "control.command"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    },
    "kind": {
      "$ref": "../../variables/kind.json"
    }
  },
  "examples": [
    {
      "type": "control.command",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "kind": "takeoff",
      "target_altitude": {
        "altitude_m": 30,
        "altitude_reference": "home"
      }
    },
    {
      "type": "control.command",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "kind": "move_to",
      "destination": {
        "latitude": 42.2746,
        "longitude": -71.8063,
        "altitudes": [
          {
            "altitude_m": 30,
            "altitude_reference": "home"
          }
        ]
      }
    },
    {
      "type": "control.command",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "kind": "land",
      "landing_position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      },
      "transit_altitude": {
        "altitude_m": 20,
        "altitude_reference": "home"
      }
    },
    {
      "type": "control.command",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "kind": "change_settings",
      "lights": "on"
    }
  ]
}
