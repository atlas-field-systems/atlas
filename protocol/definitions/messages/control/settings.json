{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/control/settings.json",
  "title": "Settings change",
  "description": "From Core (or from an operator interface to Core, which checks it and passes it on): set one or more settings, each to an explicit end state. Without task_id it is done now (a button press) and confirmed by report.settings whose reply_to is this seq. With task_id it is a change_settings Task in the queue, confirmed by its task status. land_at_position is where land_at goes; it need not be the takeoff point. At least one setting must be present.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "control.settings"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    },
    "task_id": {
      "$ref": "../../variables/task_id.json"
    },
    "task_seq": {
      "$ref": "../../variables/task_seq.json"
    },
    "run_state": {
      "$ref": "../../variables/run_state.json"
    },
    "lights": {
      "$ref": "../../variables/lights.json"
    },
    "landing_gear": {
      "$ref": "../../variables/landing_gear.json"
    },
    "link_loss_response": {
      "$ref": "../../variables/link_loss_response.json"
    },
    "low_battery_response": {
      "$ref": "../../variables/low_battery_response.json"
    },
    "land_at_position": {
      "$ref": "../../components/position.json"
    }
  },
  "anyOf": [
    {
      "required": [
        "run_state"
      ]
    },
    {
      "required": [
        "lights"
      ]
    },
    {
      "required": [
        "landing_gear"
      ]
    },
    {
      "required": [
        "link_loss_response"
      ]
    },
    {
      "required": [
        "low_battery_response"
      ]
    },
    {
      "required": [
        "land_at_position"
      ]
    }
  ],
  "examples": [
    {
      "type": "control.settings",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "lights": "on"
    },
    {
      "type": "control.settings",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "task_id": "T3",
      "task_seq": 3,
      "landing_gear": "up"
    },
    {
      "type": "control.settings",
      "time": 1793667600000,
      "seq": 43,
      "asset_id": "A1",
      "low_battery_response": "land_at",
      "land_at_position": {
        "latitude": 42.2751,
        "longitude": -71.8049
      }
    }
  ],
  "dependentRequired": {
    "task_id": [
      "task_seq"
    ],
    "task_seq": [
      "task_id"
    ]
  }
}
