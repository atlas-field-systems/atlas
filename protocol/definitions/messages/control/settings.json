{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/control/settings.json",
  "title": "Settings change",
  "description": "From Core: set one or more settings, each to an explicit end state. Without task_id it is done now (a button press) and confirmed by report.settings whose reply_to is this seq. With task_id it is a change_settings Task in the queue, confirmed by its task status. At least one setting must be present.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "control.settings"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    },
    "task_id": {
      "$ref": "../../variables/task_id.json"
    },
    "run_state": {
      "$ref": "../../variables/run_state.json"
    },
    "lights": {
      "$ref": "../../variables/lights.json"
    },
    "landing_gear": {
      "$ref": "../../variables/landing_gear.json"
    },
    "link_loss_response": {
      "$ref": "../../variables/link_loss_response.json"
    }
  },
  "anyOf": [
    {
      "required": [
        "run_state"
      ]
    },
    {
      "required": [
        "lights"
      ]
    },
    {
      "required": [
        "landing_gear"
      ]
    },
    {
      "required": [
        "link_loss_response"
      ]
    }
  ],
  "examples": [
    {
      "type": "control.settings",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "lights": "on"
    },
    {
      "type": "control.settings",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "task_id": "T3",
      "landing_gear": "up"
    }
  ]
}
