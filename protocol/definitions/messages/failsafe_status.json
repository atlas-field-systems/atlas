{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/failsafe_status.json",
  "title": "Failsafe Status",
  "description": "Report from an Asset, sent as soon as it switches on a failsafe by itself, such as returning home or its link-loss response.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id",
    "failsafe",
    "explanation"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../variables/type.json",
      "const": "failsafe_status"
    },
    "time": {
      "$ref": "../variables/time.json"
    },
    "seq": {
      "$ref": "../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "failsafe": {
      "$ref": "../variables/failsafe.json"
    },
    "explanation": {
      "$ref": "../variables/explanation.json"
    }
  },
  "examples": [
    {
      "type": "failsafe_status",
      "time": 1793667600000,
      "seq": 44,
      "asset_id": "A1",
      "failsafe": "link_loss_response",
      "explanation": "No contact with gateway for 30 s"
    }
  ]
}
