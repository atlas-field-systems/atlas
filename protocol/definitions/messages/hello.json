{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/hello.json",
  "title": "Hello",
  "description": "First message from an Asset when a link opens: which Asset it is and which protocol version it runs. Authentication (an API key) is handled by the link, not this message.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id",
    "protocol_version"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../variables/type.json",
      "const": "hello"
    },
    "time": {
      "$ref": "../variables/time.json"
    },
    "seq": {
      "$ref": "../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "protocol_version": {
      "$ref": "../variables/protocol_version.json"
    }
  },
  "examples": [
    {
      "type": "hello",
      "time": 1793667600000,
      "seq": 44,
      "asset_id": "A1",
      "protocol_version": "0.3"
    }
  ]
}
