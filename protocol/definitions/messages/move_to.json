{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/move_to.json",
  "title": "Move To",
  "description": "Command from an operator: fly to a position. If the position has no altitude, the Asset keeps its current altitude.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id",
    "destination"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../variables/type.json",
      "const": "move_to"
    },
    "time": {
      "$ref": "../variables/time.json"
    },
    "seq": {
      "$ref": "../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "destination": {
      "$ref": "../components/position.json"
    }
  },
  "examples": [
    {
      "type": "move_to",
      "time": 1793667600000,
      "seq": 43,
      "asset_id": "A1",
      "destination": {
        "latitude": 42.2746,
        "longitude": -71.8063,
        "altitudes": [
          {
            "altitude_m": 30,
            "altitude_reference": "home"
          }
        ]
      }
    }
  ]
}
