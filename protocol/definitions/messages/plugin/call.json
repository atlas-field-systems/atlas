{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/plugin/call.json",
  "title": "Plugin call",
  "description": "From an operator interface to Core: run one action of one Plugin. kind is the action, and the Plugin must list it in plugin.describe. The action's inputs sit directly in the message. Core answers with one plugin.result per output item, then admin.reply: accepted when the call finished, refused when it never ran (such as an unknown Plugin or action), or failed when the Plugin ran and broke. Only operator interfaces call Plugins for now.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "from",
    "kind",
    "plugin_id"
  ],
  "oneOf": [
    {
      "$ref": "call/ground_elevation.json"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "plugin.call"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "from": {
      "$ref": "../../variables/from.json"
    },
    "kind": {
      "$ref": "../../variables/kind.json"
    },
    "plugin_id": {
      "$ref": "../../variables/plugin_id.json"
    }
  },
  "examples": [
    {
      "type": "plugin.call",
      "time": 1793667701000,
      "seq": 3,
      "from": "OP1",
      "kind": "ground_elevation",
      "plugin_id": "DEM",
      "position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      }
    }
  ]
}
