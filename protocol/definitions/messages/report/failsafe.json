{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/report/failsafe.json",
  "title": "Failsafe",
  "description": "From an Asset, sent as soon as a failsafe triggers and it acts by itself. kind is the trigger (what happened). response is what the Asset does about it.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "from",
    "asset_id",
    "kind",
    "response"
  ],
  "oneOf": [
    {
      "$ref": "failsafe/link_loss.json"
    },
    {
      "$ref": "failsafe/low_battery.json"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "report.failsafe"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "from": {
      "$ref": "../../variables/from.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    },
    "kind": {
      "$ref": "../../variables/kind.json"
    },
    "explanation": {
      "$ref": "../../variables/explanation.json"
    },
    "response": {
      "$ref": "../../variables/failsafe_response.json"
    }
  },
  "examples": [
    {
      "type": "report.failsafe",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "kind": "link_loss",
      "response": "return_to_home",
      "explanation": "No contact with Core for 30 s",
      "from": "A1"
    },
    {
      "type": "report.failsafe",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "kind": "low_battery",
      "response": "return_to_home",
      "explanation": "Battery at 18 %",
      "from": "A1"
    }
  ]
}
