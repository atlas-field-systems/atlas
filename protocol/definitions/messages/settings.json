{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/settings.json",
  "title": "Settings",
  "description": "Sets or reports one or more of an Asset's settings, each an explicit end state. Operators send it to change them; the Asset sends it when it changes one itself. The most recent time wins. At least one setting must be present.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id"
  ],
  "minProperties": 5,
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../variables/type.json",
      "const": "settings"
    },
    "time": {
      "$ref": "../variables/time.json"
    },
    "seq": {
      "$ref": "../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "run_state": {
      "$ref": "../variables/run_state.json"
    },
    "lights": {
      "$ref": "../variables/lights.json"
    },
    "landing_gear": {
      "$ref": "../variables/landing_gear.json"
    },
    "link_loss_response": {
      "$ref": "../variables/link_loss_response.json"
    }
  },
  "examples": [
    {
      "type": "settings",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "lights": "on",
      "landing_gear": "down"
    }
  ]
}
