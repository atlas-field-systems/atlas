{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/status.json",
  "title": "Status",
  "description": "Report from an Asset: its overall health. Link health and Task progress are reported separately.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id",
    "condition"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../variables/type.json",
      "const": "status"
    },
    "time": {
      "$ref": "../variables/time.json"
    },
    "seq": {
      "$ref": "../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "condition": {
      "$ref": "../variables/condition.json"
    },
    "explanation": {
      "$ref": "../variables/explanation.json"
    }
  },
  "examples": [
    {
      "type": "status",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "8b2e6d1a-3c4f-4a5b-9e7d-1f2a3b4c5d6e",
      "condition": "degraded",
      "explanation": "Navigation receiver unavailable"
    }
  ]
}
