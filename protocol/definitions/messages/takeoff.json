{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/takeoff.json",
  "title": "Takeoff",
  "description": "Command from an operator: leave the ground and climb to a target altitude.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id",
    "target_altitude"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../variables/type.json",
      "const": "takeoff"
    },
    "time": {
      "$ref": "../variables/time.json"
    },
    "seq": {
      "$ref": "../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "target_altitude": {
      "$ref": "../components/altitude.json"
    }
  },
  "examples": [
    {
      "type": "takeoff",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "8b2e6d1a-3c4f-4a5b-9e7d-1f2a3b4c5d6e",
      "target_altitude": {
        "altitude_m": 30,
        "altitude_reference": "home"
      }
    }
  ]
}
