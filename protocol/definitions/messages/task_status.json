{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/task_status.json",
  "title": "Task Status",
  "description": "Report from an Asset: where one of its Tasks stands. Only these reports move a Task forward.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "asset_id",
    "task_id",
    "task_state"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../variables/type.json",
      "const": "task_status"
    },
    "time": {
      "$ref": "../variables/time.json"
    },
    "seq": {
      "$ref": "../variables/seq.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "task_id": {
      "$ref": "../variables/task_id.json"
    },
    "task_state": {
      "$ref": "../variables/task_state.json"
    },
    "explanation": {
      "$ref": "../variables/explanation.json"
    }
  },
  "examples": [
    {
      "type": "task_status",
      "time": 1793667600000,
      "seq": 44,
      "asset_id": "A1",
      "task_id": "T7",
      "task_state": "active"
    },
    {
      "type": "task_status",
      "time": 1793667600000,
      "seq": 44,
      "asset_id": "A1",
      "task_id": "T7",
      "task_state": "failed",
      "explanation": "Destination outside geofence"
    }
  ]
}
