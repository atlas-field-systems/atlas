{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/carrier.json",
  "title": "Carrier",
  "description": "Which gateway carries a radio Asset. Core adds it as asset.carried when a radio Asset moves to the gateway that heard it, with that gateway_id, or when its gateway is removed, without one: the Asset is then carried by no gateway.",
  "type": "object",
  "required": [
    "time",
    "asset_id"
  ],
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "gateway_id": {
      "$ref": "../variables/gateway_id.json"
    }
  },
  "examples": [
    {
      "time": 1793667605000,
      "asset_id": "R7",
      "gateway_id": "G1"
    },
    {
      "time": 1793667990000,
      "asset_id": "R7"
    }
  ]
}
