{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/plugin/description.json",
  "title": "Plugin description",
  "description": "What a Plugin offers: a name for operators and the actions it takes calls for, each with its inputs, at most 16 actions. A Plugin sends it with PUT /plugins/{plugin_id}/description each time it starts, and Core adds it as plugin.described. Each Plugin names and describes its own actions; Protocol defines only the common pieces they are built from, so a new action needs no Protocol change.",
  "type": "object",
  "required": [
    "type",
    "time",
    "plugin_id",
    "name",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "plugin.description"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "plugin_id": {
      "$ref": "../../variables/plugin_id.json"
    },
    "name": {
      "$ref": "../../variables/name.json"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "../../components/plugin_action.json"
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "examples": [
    {
      "type": "plugin.description",
      "time": 1793667700000,
      "plugin_id": "P1",
      "name": "Map lookups",
      "actions": [
        {
          "action": "find_buildings",
          "label": "Find buildings",
          "inputs": [
            {
              "input": "box",
              "label": "Area to search",
              "input_kind": "area"
            }
          ]
        },
        {
          "action": "weather",
          "label": "Weather",
          "inputs": [
            {
              "input": "spot",
              "label": "Where",
              "input_kind": "position"
            },
            {
              "input": "when",
              "label": "Forecast time",
              "input_kind": "time",
              "optional": true
            }
          ]
        },
        {
          "action": "places",
          "label": "Points of interest",
          "inputs": [
            {
              "input": "box",
              "label": "Area to search",
              "input_kind": "area"
            },
            {
              "input": "type",
              "label": "Kind of place",
              "input_kind": "choice",
              "choices": [
                "hospital",
                "helipad",
                "open_field"
              ]
            }
          ]
        }
      ]
    }
  ]
}
