{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/provisioning.json",
  "title": "Provisioning",
  "description": "An Asset or a gateway was added to Core or removed from it. It names exactly one of asset_id or gateway_id. The event kind says whether it was provisioned or removed, so the record does not. requested_by is the admin who did it, or the gateway that added a radio Asset on first contact. What kind of Asset it is comes later, from its description.",
  "type": "object",
  "required": [
    "time",
    "requested_by"
  ],
  "anyOf": [
    {
      "required": [
        "asset_id"
      ]
    },
    {
      "required": [
        "gateway_id"
      ]
    }
  ],
  "not": {
    "required": [
      "asset_id",
      "gateway_id"
    ]
  },
  "additionalProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "gateway_id": {
      "$ref": "../variables/gateway_id.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "asset_id": "A1",
      "requested_by": "AD1"
    },
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "requested_by": "AD1"
    },
    {
      "time": 1793667605000,
      "asset_id": "R7",
      "requested_by": "G1"
    }
  ]
}
