{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/refusal.json",
  "title": "Refusal",
  "description": "Core refused a caller and added no Asset. The event kind says why. definitions.refused: an Asset on IP, gateway, or Plugin, named by its ID, or a radio, named by its gateway_id, radio_identity, and asset_id if it has one, connected with a different definitions_hash, which the record carries. radio.refused: a gateway heard a radio whose Asset an admin removed; the record names the gateway_id, the radio_identity, and the removed asset_id, and carries no hash.",
  "type": "object",
  "required": [
    "time"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "definitions_hash"
      ],
      "not": {
        "required": [
          "radio_identity"
        ]
      },
      "oneOf": [
        {
          "required": [
            "asset_id"
          ]
        },
        {
          "required": [
            "gateway_id"
          ]
        },
        {
          "required": [
            "plugin_id"
          ]
        }
      ]
    },
    {
      "required": [
        "gateway_id",
        "radio_identity",
        "definitions_hash"
      ],
      "not": {
        "required": [
          "plugin_id"
        ]
      }
    },
    {
      "required": [
        "gateway_id",
        "radio_identity",
        "asset_id"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "plugin_id"
            ]
          },
          {
            "required": [
              "definitions_hash"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "gateway_id": {
      "$ref": "../variables/gateway_id.json"
    },
    "plugin_id": {
      "$ref": "../variables/plugin_id.json"
    },
    "radio_identity": {
      "$ref": "../variables/radio_identity.json"
    },
    "definitions_hash": {
      "$ref": "../variables/definitions_hash.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "plugin_id": "P1",
      "definitions_hash": "sha256:41aa07"
    },
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "radio_identity": "meshtastic:q3Vb0n8fW2aJ6kXyR1tLmE4sP9dZcHgU7oNiTvB5wQA=",
      "asset_id": "R7",
      "definitions_hash": "sha256:41aa07"
    },
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "radio_identity": "meshtastic:q3Vb0n8fW2aJ6kXyR1tLmE4sP9dZcHgU7oNiTvB5wQA=",
      "definitions_hash": "sha256:41aa07"
    },
    {
      "time": 1793667600000,
      "gateway_id": "G1",
      "radio_identity": "meshtastic:q3Vb0n8fW2aJ6kXyR1tLmE4sP9dZcHgU7oNiTvB5wQA=",
      "asset_id": "R7"
    }
  ]
}
