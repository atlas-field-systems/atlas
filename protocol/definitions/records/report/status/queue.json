{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/report/status/queue.json",
  "title": "queue",
  "description": "The Asset's task list: the task_id of every Task it holds and has not started, in the order it will run them. Sent whenever the list changes and when the Asset starts or reconnects with a list. An empty list means nothing is queued. When it answers a request, request_id names it. This is the complete list, never a truncated or windowed subset. Core counts the latest one against its cap of 64 ordinary Tasks per Asset. The Asset reports a further ordinary Task cancelled once it holds 64, so the list never exceeds 64. A `now` Task is active, not held.",
  "type": "object",
  "required": [
    "kind",
    "task_ids"
  ],
  "properties": {
    "kind": {
      "$ref": "../../../variables/kind.json",
      "const": "queue"
    },
    "task_ids": {
      "type": "array",
      "items": {
        "$ref": "../../../variables/task_id.json"
      },
      "maxItems": 64
    },
    "request_id": {
      "$ref": "../../../variables/request_id.json"
    }
  },
  "examples": [
    {
      "kind": "queue",
      "task_ids": [
        1,
        2,
        3
      ],
      "request_id": 120
    },
    {
      "kind": "queue",
      "task_ids": []
    },
