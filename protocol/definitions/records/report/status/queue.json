{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/report/status/queue.json",
  "title": "queue",
  "description": "The Asset's task list: the task_id of every Task it has not started, in the order it will run them, and the list's queue_version. Sent whenever the list changes and when the Asset starts or reconnects with a list. An empty list means nothing is queued. When it answers a queue, request_id names it.",
  "type": "object",
  "required": [
    "kind",
    "queue_version",
    "task_ids"
  ],
  "properties": {
    "kind": {
      "$ref": "../../../variables/kind.json",
      "const": "queue"
    },
    "queue_version": {
      "$ref": "../../../variables/queue_version.json"
    },
    "task_ids": {
      "type": "array",
      "items": {
        "$ref": "../../../variables/task_id.json"
      },
      "maxItems": 64
    },
    "request_id": {
      "$ref": "../../../variables/request_id.json"
    }
  },
  "examples": [
    {
      "kind": "queue",
      "queue_version": 1,
      "task_ids": [
        "T1",
        "T2",
        "T3"
      ],
      "request_id": 120
    },
    {
      "kind": "queue",
      "queue_version": 2,
      "task_ids": []
    }
  ]
}
