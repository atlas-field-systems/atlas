{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/report/status/queue.json",
  "title": "queue",
  "description": "The Asset's task list: the task_id of every Task it holds and has not started, in the order it will run them, and its clear_count. Sent whenever the list changes and when the Asset starts or reconnects with a list. An empty list means nothing is queued. When it answers a request, request_id names it.",
  "type": "object",
  "required": [
    "kind",
    "clear_count",
    "task_ids"
  ],
  "properties": {
    "kind": {
      "$ref": "../../../variables/kind.json",
      "const": "queue"
    },
    "clear_count": {
      "$ref": "../../../variables/clear_count.json"
    },
    "task_ids": {
      "type": "array",
      "items": {
        "$ref": "../../../variables/task_id.json"
      },
      "maxItems": 64
    },
    "request_id": {
      "$ref": "../../../variables/request_id.json"
    }
  },
  "examples": [
    {
      "kind": "queue",
      "clear_count": 1,
      "task_ids": [
        1,
        2,
        3
      ],
      "request_id": 120
    },
    {
      "kind": "queue",
      "clear_count": 2,
      "task_ids": []
    }
  ]
}
