{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/report/status/task.json",
  "title": "task",
  "description": "One of the Asset's Tasks and its state. Only these reports move a Task forward, and only forward. explanation says why a Task failed or was cancelled. When it answers a cancel, request_id names it.",
  "type": "object",
  "required": [
    "kind",
    "task_id",
    "task_state"
  ],
  "properties": {
    "kind": {
      "$ref": "../../../variables/kind.json",
      "const": "task"
    },
    "task_id": {
      "$ref": "../../../variables/task_id.json"
    },
    "task_state": {
      "$ref": "../../../variables/task_state.json"
    },
    "explanation": {
      "$ref": "../../../variables/explanation.json"
    },
    "request_id": {
      "$ref": "../../../variables/request_id.json"
    }
  },
  "examples": [
    {
      "kind": "task",
      "task_id": 7,
      "task_state": "active"
    },
    {
      "kind": "task",
      "task_id": 3,
      "task_state": "failed",
      "explanation": "Landing position out of reach"
    },
    {
      "kind": "task",
      "task_id": 2,
      "task_state": "cancelled",
      "request_id": 121
    }
  ]
}
