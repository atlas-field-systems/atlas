{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/records/task.json",
  "title": "Task",
  "description": "A Task's body defines one piece of work for an Asset. kind names a command kind the Asset lists in its description, or settings for a settings change made when the Task runs. Core assigns task_id. The body never changes. The Asset's report.status kind task records its state, and a queue says when it runs.",
  "type": "object",
  "required": [
    "time",
    "asset_id",
    "task_id",
    "requested_by",
    "kind"
  ],
  "oneOf": [
    {
      "$ref": "task/takeoff.json"
    },
    {
      "$ref": "task/move_to.json"
    },
    {
      "$ref": "task/land.json"
    },
    {
      "$ref": "task/return_to_home.json"
    },
    {
      "$ref": "task/settings.json"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "time": {
      "$ref": "../variables/time.json"
    },
    "asset_id": {
      "$ref": "../variables/asset_id.json"
    },
    "task_id": {
      "$ref": "../variables/task_id.json"
    },
    "requested_by": {
      "$ref": "../variables/requested_by.json"
    },
    "kind": {
      "$ref": "../variables/kind.json"
    }
  },
  "examples": [
    {
      "time": 1793667600000,
      "asset_id": "A1",
      "task_id": "T1",
      "requested_by": "OP1",
      "kind": "takeoff",
      "target_altitude": {
        "altitude_m": 30,
        "altitude_reference": "launch"
      }
    },
    {
      "time": 1793667601000,
      "asset_id": "A1",
      "task_id": "T2",
      "requested_by": "OP1",
      "kind": "move_to",
      "destination": {
        "latitude": 42.2746,
        "longitude": -71.8063,
        "altitudes": [
          {
            "altitude_m": 30,
            "altitude_reference": "launch"
          }
        ]
      }
    },
    {
      "time": 1793667602000,
      "asset_id": "A1",
      "task_id": "T3",
      "requested_by": "OP1",
      "kind": "land",
      "landing_position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      },
      "transit_altitude": {
        "altitude_m": 20,
        "altitude_reference": "launch"
      }
    },
    {
      "time": 1793667603000,
      "asset_id": "A1",
      "task_id": "T4",
      "requested_by": "OP1",
      "kind": "return_to_home"
    },
    {
      "time": 1793667604000,
      "asset_id": "A1",
      "task_id": "T5",
      "requested_by": "OP1",
      "kind": "settings",
      "settings": {
        "landing_gear": "up"
      }
    }
  ]
}
