{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/requests/asset.json",
  "title": "Asset request",
  "description": "The body of POST /entities/assets, which an Asset on IP sends to register: its description without time and asset_id. It takes exactly the description record's other fields. Core assigns the asset_id, or returns the same one when the key already registered an Asset in this run, and stamps time to make the description record.",
  "type": "object",
  "required": [
    "reports",
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "entity_type": {
      "$ref": "../variables/entity_type.json"
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "../variables/report.json"
      },
      "minItems": 1,
      "maxItems": 6
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "../variables/command.json"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "../variables/setting.json"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "subsystems": {
      "type": "array",
      "items": {
        "$ref": "../components/subsystem.json"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "../components/camera.json"
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "examples": [
    {
      "entity_type": "drone",
      "reports": [
        "status",
        "failsafe",
        "telemetry",
        "battery",
        "settings"
      ],
      "commands": [
        "takeoff",
        "move_to",
        "land",
        "return_to_home",
        "hold",
        "failsafe"
      ],
      "settings": [
        "run_state",
        "lights",
        "landing_gear",
        "link_loss_after_s",
        "failsafe_policy",
        "home_position",
        "telemetry_every_s"
      ],
      "subsystems": [
        {
          "subsystem_id": "FC",
          "label": "Flight controller"
        },
        {
          "subsystem_id": "GPS",
          "label": "GPS receiver"
        },
        {
          "subsystem_id": "C1",
          "label": "Gimbal camera"
        }
      ],
      "cameras": [
        {
          "camera_id": "C1",
          "mount": "gimbal",
          "yaw_deg": 0,
          "pitch_deg": -45,
          "horizontal_fov_deg": 80,
          "vertical_fov_deg": 60
        }
      ]
    },
    {
      "entity_type": "fixed_sensor",
      "reports": [
        "status",
        "observation"
      ],
      "commands": []
    }
  ]
}
