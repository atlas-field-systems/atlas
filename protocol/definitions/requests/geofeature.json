{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/requests/geofeature.json",
  "title": "Geo feature request",
  "description": "The body of POST /entities/geofeatures, which creates a geo feature, and PUT /entities/geofeatures/{geofeature_id}, which replaces one whole: its kind and an optional name. A name left out of a replacement is cleared. Core stamps time and, on creation, assigns geofeature_id to make the geofeature record. Its kinds are exactly the geofeature record's kinds.",
  "type": "object",
  "required": [
    "kind"
  ],
  "oneOf": [
    {
      "$ref": "../records/geofeature/point.json"
    },
    {
      "$ref": "../records/geofeature/line.json"
    },
    {
      "$ref": "../records/geofeature/area.json"
    },
    {
      "$ref": "../records/geofeature/imagery.json"
    }
  ],
  "unevaluatedProperties": false,
  "properties": {
    "kind": {
      "$ref": "../variables/kind.json"
    },
    "name": {
      "$ref": "../variables/name.json"
    }
  },
  "examples": [
    {
      "kind": "area",
      "name": "North field",
      "area": [
        {
          "latitude": 42.2761,
          "longitude": -71.8031
        },
        {
          "latitude": 42.2768,
          "longitude": -71.8012
        },
        {
          "latitude": 42.2752,
          "longitude": -71.8004
        },
        {
          "latitude": 42.2747,
          "longitude": -71.8025
        }
      ]
    },
    {
      "kind": "point",
      "position": {
        "latitude": 42.2746,
        "longitude": -71.8063
      }
    },
    {
      "kind": "imagery",
      "name": "North field imagery",
      "object_id": "F2"
    }
  ]
}
