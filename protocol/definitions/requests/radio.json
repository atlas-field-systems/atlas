{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/requests/radio.json",
  "title": "Radio request",
  "description": "The body of POST /entities/assets/radios, which a gateway sends each time a radio's link to it opens: the radio's identity and the definitions hash the radio uses. Core answers with the radio's asset_id, or refuses it and adds a refusal.",
  "type": "object",
  "required": [
    "radio_identity",
    "definitions_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "radio_identity": {
      "$ref": "../variables/radio_identity.json"
    },
    "definitions_hash": {
      "$ref": "../variables/definitions_hash.json"
    }
  },
  "examples": [
    {
      "radio_identity": "meshtastic:q3Vb0n8fW2aJ6kXyR1tLmE4sP9dZcHgU7oNiTvB5wQA=",
      "definitions_hash": "sha256:9f2c41d0b7e3"
    }
  ]
}
