{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/variables/plan_id.json",
  "title": "plan_id",
  "description": "Which Plan a Task belongs to. Up to 4 letters or digits, such as \"P1\".",
  "type": "string",
  "pattern": "^[A-Za-z0-9]{1,4}$",
  "minLength": 1,
  "maxLength": 4,
  "examples": [
    "P1"
  ]
}
