{
  "name": "@atlas/protocol",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/types.mjs --check",
    "test": "node --test test/*.test.mjs",
    "cli": "node cli/cli.mjs",
    "site": "node scripts/build-site.mjs && node scripts/serve.mjs",
    "build:site": "node scripts/build-site.mjs",
    "types": "node scripts/types.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.3",
    "marked": "^18.1.3"
  },
  "bin": {
    "atlas-protocol": "cli/cli.mjs"
  },
  "files": [
    "cli",
    "lib",
    "definitions",
    "types.d.ts"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./lib/node.d.ts",
      "default": "./lib/node.mjs"
    },
    "./browser": {
      "types": "./lib/browser.d.ts",
      "default": "./lib/browser.mjs"
    },
    "./types": {
      "types": "./types.d.ts"
    }
  },
  "version": "0.1.0"
}
