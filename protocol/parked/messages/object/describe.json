{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/object/describe.json",
  "title": "Object describe",
  "description": "From Core (from is CORE) to every operator interface: one Object, a file Core holds. Core sends it once the file is stored, and for every Object when an operator connects. The file itself never travels in a message (law 13): an operator interface fetches it from Core by object_id only when it needs it. geofeature_id names the one geo feature the Object is attached to, if any; plugin_id names the Plugin that made it, if one did.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "from",
    "object_id",
    "content_type",
    "size_bytes"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "object.describe"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "from": {
      "$ref": "../../variables/from.json"
    },
    "object_id": {
      "$ref": "../../variables/object_id.json"
    },
    "name": {
      "$ref": "../../variables/name.json"
    },
    "content_type": {
      "$ref": "../../variables/content_type.json"
    },
    "size_bytes": {
      "$ref": "../../variables/size_bytes.json"
    },
    "geofeature_id": {
      "$ref": "../../variables/geofeature_id.json"
    },
    "plugin_id": {
      "$ref": "../../variables/plugin_id.json"
    }
  },
  "examples": [
    {
      "type": "object.describe",
      "time": 1793667830000,
      "seq": 113,
      "from": "CORE",
      "object_id": "F1",
      "name": "roof-survey.jpg",
      "content_type": "image/jpeg",
      "size_bytes": 2483117,
      "geofeature_id": "G1",
      "plugin_id": "IMG"
    }
  ]
}
