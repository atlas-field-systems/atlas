{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/report/gimbal.json",
  "title": "Gimbal report",
  "description": "Where a gimbal camera is pointing, relative to the Asset's nose and level body. Sent often while the gimbal is active (moving or in use), and not at all while it is idle; the last one stays true until a new one arrives.",
  "type": "object",
  "required": [
    "type",
    "time",
    "seq",
    "from",
    "asset_id",
    "camera_id",
    "yaw_deg",
    "pitch_deg"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "$ref": "../../variables/type.json",
      "const": "report.gimbal"
    },
    "time": {
      "$ref": "../../variables/time.json"
    },
    "seq": {
      "$ref": "../../variables/seq.json"
    },
    "from": {
      "$ref": "../../variables/from.json"
    },
    "asset_id": {
      "$ref": "../../variables/asset_id.json"
    },
    "camera_id": {
      "$ref": "../../variables/camera_id.json"
    },
    "yaw_deg": {
      "$ref": "../../variables/yaw_deg.json"
    },
    "pitch_deg": {
      "$ref": "../../variables/pitch_deg.json"
    }
  },
  "examples": [
    {
      "type": "report.gimbal",
      "time": 1793667600000,
      "seq": 42,
      "asset_id": "A1",
      "camera_id": "C1",
      "yaw_deg": 35,
      "pitch_deg": -30,
      "from": "A1"
    }
  ]
}
