{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-field-systems.github.io/protocol/definitions/messages/report/observation/bearing.json",
  "title": "bearing",
  "description": "The sensor knows which way the target is from where the sensor was when it saw it: the origin it recorded at that moment (not taken from telemetry), the bearing, and optionally the elevation and range, each with its own uncertainty. Fusion turns these into a place.",
  "type": "object",
  "required": [
    "kind",
    "origin",
    "bearing_deg"
  ],
  "dependentRequired": {
    "bearing_uncertainty_deg": [
      "bearing_deg"
    ],
    "elevation_uncertainty_deg": [
      "elevation_deg"
    ],
    "range_uncertainty_m": [
      "range_m"
    ]
  },
  "properties": {
    "kind": {
      "$ref": "../../../variables/kind.json",
      "const": "bearing"
    },
    "origin": {
      "$ref": "../../../components/position.json"
    },
    "bearing_deg": {
      "$ref": "../../../variables/bearing_deg.json"
    },
    "bearing_uncertainty_deg": {
      "$ref": "../../../variables/bearing_uncertainty_deg.json"
    },
    "elevation_deg": {
      "$ref": "../../../variables/elevation_deg.json"
    },
    "elevation_uncertainty_deg": {
      "$ref": "../../../variables/elevation_uncertainty_deg.json"
    },
    "range_m": {
      "$ref": "../../../variables/range_m.json"
    },
    "range_uncertainty_m": {
      "$ref": "../../../variables/range_uncertainty_m.json"
    }
  },
  "examples": [
    {
      "kind": "bearing",
      "origin": {
        "latitude": 42.2758,
        "longitude": -71.8041
      },
      "bearing_deg": 117,
      "bearing_uncertainty_deg": 2
    }
  ]
}
